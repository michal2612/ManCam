{
  "version": 10,
  "configurePresets": [
    {
      "name": "mac-llvm",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-llvm",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER" : "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_BUILD_TYPE" : "Debug"
      }
    },
    {
      "name": "mac-llvm-github",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-llvm",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CC}",
        "CMAKE_CXX_COMPILER": "$env{CXX}",
        "CMAKE_CXX_FLAGS": "-nostdinc++ -isystem $env{LLVM_PREFIX}/include/c++/v1",
        "CMAKE_EXE_LINKER_FLAGS": "-L$env{LLVM_PREFIX}/lib/c++ -Wl,-rpath,$env{LLVM_PREFIX}/lib/c++",
        "CMAKE_SHARED_LINKER_FLAGS": "-L$env{LLVM_PREFIX}/lib/c++ -Wl,-rpath,$env{LLVM_PREFIX}/lib/c++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mac-llvm",
      "configurePreset": "mac-llvm"
    },
    {
      "name": "mac-llvm-github",
      "configurePreset": "mac-llvm"
    }
  ],
  "testPresets": [
    {
      "name": "mac-llvm",
      "configurePreset": "mac-llvm",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "stopOnFailure": true}
    },
    {
      "name": "mac-llvm-github",
      "configurePreset": "mac-llvm-github",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "stopOnFailure": true}
    }
  ]
}